<sukiUi:SukiWindow
    CanResize="False"
    Closing="Onclose"
    Height="800"
    KeyDown="OnKeyDown"
    Title="异常检测"
    Width="1500"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    x:Class="AlgorithmAcceptanceToolAvalonia.Views.RiskDetectView"
    x:DataType="vm:RiskDetectViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sukiUi="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    xmlns:vm="clr-namespace:AlgorithmAcceptanceToolAvalonia.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.DataContext>
        <vm:RiskDetectViewModel />
    </Design.DataContext>
    <sukiUi:SukiWindow.Hosts>
        <sukiUi:SukiDialogHost Manager="{Binding DialogManager}" />
    </sukiUi:SukiWindow.Hosts>
    <Window.KeyBindings>
        <KeyBinding Command="{Binding NextJpgCommand}" Gesture="D" />
        <KeyBinding Command="{Binding NextJpgCommand}" Gesture="S" />
        <KeyBinding Command="{Binding PreviousJpgCommand}" Gesture="A" />
        <KeyBinding Command="{Binding PreviousJpgCommand}" Gesture="W" />
        <KeyBinding Command="{Binding RevokeErrorCommand}" Gesture="Q" />
        <KeyBinding
            Command="{Binding MarkErrorCommand}"
            CommandParameter="true"
            Gesture="E" />
        <KeyBinding
            Command="{Binding MarkErrorCommand}"
            CommandParameter="false"
            Gesture="F" />
    </Window.KeyBindings>


    <Grid
        ColumnDefinitions="400, *"
        RenderOptions.BitmapInterpolationMode="HighQuality"
        RowDefinitions="50,50,50,200,300,50,*">
        <StackPanel
            Grid.Column="0"
            Grid.Row="0"
            Margin="5"
            Orientation="Horizontal">
            <TextBlock
                HorizontalAlignment="Center"
                Text="检测目录："
                VerticalAlignment="Center" />
            <TextBox
                Height="40"
                HorizontalContentAlignment="Center"
                IsReadOnly="True"
                Text="{Binding ImagePath}"
                VerticalContentAlignment="Center"
                Width="200" />
            <Button
                Click="OpenFolder"
                Content="选择目录"
                Height="40"
                IsEnabled="{Binding !IsAnalyzing}"
                Margin="5" />

        </StackPanel>
        <StackPanel
            Grid.Column="0"
            Grid.Row="1"
            Margin="5"
            Orientation="Horizontal">
            <TextBlock Text="类别：" VerticalAlignment="Center" />
            <ComboBox
                IsEnabled="{Binding !IsAnalyzing}"
                ItemsSource="{Binding TaskNameList}"
                Margin="5"
                SelectedItem="{Binding SelectedTaskName}"
                VerticalAlignment="Center" />
            <CheckBox
                Content="裁剪至目标框"
                IsChecked="{Binding CropImage}"
                IsEnabled="{Binding !IsAnalyzing}"
                Margin="5"
                Width="120" />

        </StackPanel>
        <StackPanel
            Grid.Column="0"
            Grid.Row="2"
            Margin="5"
            Orientation="Horizontal">
            <TextBlock Text="操作：" VerticalAlignment="Center" />


            <Button
                Command="{Binding AnalyzeRisksCommand}"
                Content="开始分析"
                Height="40"
                Margin="5" />
        </StackPanel>
        <DataGrid
            BorderBrush="Gray"
            BorderThickness="1"
            CanUserReorderColumns="False"
            CanUserResizeColumns="False"
            CanUserSortColumns="False"
            Grid.Column="1"
            Grid.Row="0"
            Grid.RowSpan="4"
            GridLinesVisibility="None"
            IsEnabled="{Binding !IsAnalyzing}"
            IsReadOnly="True"
            ItemsSource="{Binding RiskDetectResults}"
            Margin="20"
            Name="RiskDetectResultsGrid"
            SelectedIndex="{Binding SelectedDataGridIndex}"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Binding="{Binding Timestamp}"
                    Header="时间"
                    Width="160" />

                <DataGridTextColumn
                    Binding="{Binding FileName}"
                    Header="文件名"
                    Width="320" />
                <DataGridTextColumn
                    Binding="{Binding TaskName}"
                    Header="任务"
                    Width="130" />
                <DataGridTextColumn
                    Binding="{Binding GuessedLabel}"
                    Header="猜测标签"
                    Width="130" />
                <DataGridTextColumn
                    Binding="{Binding PredictLabel}"
                    Header="预测标签"
                    Width="130" />
                <DataGridTextColumn
                    Binding="{Binding PredictScore}"
                    Header="预测分数"
                    Width="150" />
            </DataGrid.Columns>
        </DataGrid>
        <Image
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Grid.Row="4"
            Source="{Binding PresentImage}"
            Stretch="Fill" />
        <StackPanel
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Grid.Row="5"
            HorizontalAlignment="Center"
            Orientation="Horizontal">

            <Button
                Classes="Standard"
                Command="{Binding PreviousJpgCommand}"
                Content="上一张（A/W）"
                Margin="0,10,10,0"
                Width="250" />
            <Button
                Classes="Standard"
                Command="{Binding NextJpgCommand}"
                Content="下一张（S/D）"
                Margin="0,10,10,0"
                Width="250" />
            <Button
                Classes="Outlined Danger"
                Command="{Binding MarkErrorCommand}"
                CommandParameter="true"
                Content="标记异常（E）"
                Margin="0,10,0,0"
                Width="250" />
            <Button
                Classes="Outlined Success"
                Command="{Binding MarkErrorCommand}"
                CommandParameter="false"
                Content="标记误检（F）"
                Margin="10,10,0,0"
                Width="250" />
            <Button
                Classes="Outlined Information"
                Command="{Binding RevokeErrorCommand}"
                CommandParameter="false"
                Content="撤销标记（Q）"
                Margin="10,10,0,0"
                Width="200" />
        </StackPanel>

    </Grid>
</sukiUi:SukiWindow>
