<sukiUi:SukiWindow
    CanResize="False"
    Closing="Onclose"
    Height="800"
    KeyDown="OnKeyDown"
    Title="异常检测"
    Width="1500"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    x:Class="AlgorithmAcceptanceToolAvalonia.Views.RiskDetectView"
    x:DataType="vm:RiskDetectViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sukiUi="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    xmlns:vm="clr-namespace:AlgorithmAcceptanceToolAvalonia.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.DataContext>
        <vm:RiskDetectViewModel />
    </Design.DataContext>
    <sukiUi:SukiWindow.Hosts>
        <sukiUi:SukiDialogHost Manager="{Binding DialogManager}" />
    </sukiUi:SukiWindow.Hosts>
    <Window.KeyBindings>
        <KeyBinding Command="{Binding InitializePlayTimerCommand}" Gesture="V" />
        <KeyBinding Command="{Binding NextJpgCommand}" Gesture="D" />
        <KeyBinding Command="{Binding NextJpgCommand}" Gesture="S" />
        <KeyBinding Command="{Binding NextJpgCommand}" Gesture="Down" />
        <KeyBinding Command="{Binding NextJpgCommand}" Gesture="Right" />
        <KeyBinding Command="{Binding PreviousJpgCommand}" Gesture="A" />
        <KeyBinding Command="{Binding PreviousJpgCommand}" Gesture="W" />
        <KeyBinding Command="{Binding PreviousJpgCommand}" Gesture="Left" />
        <KeyBinding Command="{Binding PreviousJpgCommand}" Gesture="Up" />
        <KeyBinding Command="{Binding RevokeErrorCommand}" Gesture="Q" />
        <KeyBinding
            Command="{Binding MarkErrorCommand}"
            CommandParameter="true"
            Gesture="E" />
        <KeyBinding
            Command="{Binding MarkErrorCommand}"
            CommandParameter="false"
            Gesture="F" />
    </Window.KeyBindings>


    <Grid
        ColumnDefinitions="400, *"
        RenderOptions.BitmapInterpolationMode="HighQuality"
        RowDefinitions="40,40,40,40,40,400,50,50,*">
        <StackPanel
            Grid.Column="0"
            Grid.Row="0"
            Margin="5"
            Orientation="Horizontal">
            <Button
                Click="OpenFolder"
                Content="选择目录"
                Height="40"
                IsEnabled="{Binding !IsAnalyzing}"
                Margin="5"
                Padding="0"
                Width="80" />
            <TextBox
                Height="40"
                HorizontalContentAlignment="Center"
                IsEnabled="False"
                IsReadOnly="True"
                Text="{Binding ImagePath}"
                VerticalContentAlignment="Center"
                Width="150" />

            <ComboBox
                IsEnabled="{Binding !IsAnalyzing}"
                ItemsSource="{Binding TaskNameList}"
                Margin="5"
                SelectedItem="{Binding SelectedTaskName}"
                VerticalAlignment="Center" />

        </StackPanel>
        <StackPanel
            Grid.Column="0"
            Grid.Row="1"
            Margin="5"
            Orientation="Horizontal">
            <ComboBox
                IsEnabled="{Binding !IsAnalyzing}"
                ItemsSource="{Binding DrawLabelScaleList}"
                Margin="5"
                SelectedItem="{Binding DrawLabelScale}"
                Width="120" />
            <CheckBox
                Content="放大标注框"
                IsChecked="{Binding DrawLabel}"
                IsEnabled="{Binding !IsAnalyzing}"
                Margin="5"
                Width="120" />
            <CheckBox
                Content="裁剪小图"
                IsChecked="{Binding CropImage}"
                IsEnabled="{Binding !IsAnalyzing}"
                Margin="5"
                Width="120" />


        </StackPanel>
        <StackPanel
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Grid.Row="2"
            Margin="5"
            Orientation="Horizontal">
            <ComboBox
                IsEnabled="{Binding !IsAnalyzing}"
                ItemsSource="{Binding BrightnessList}"
                Margin="5"
                SelectedItem="{Binding Brightness}"
                Width="100" />
            <CheckBox
                Content="图片显示亮度提高(便于挑错)"
                IsChecked="{Binding AddBrightness}"
                IsEnabled="{Binding !IsAnalyzing}"
                Margin="5" />


        </StackPanel>
        <StackPanel
            Grid.Column="0"
            Grid.Row="3"
            Margin="5"
            Orientation="Horizontal">
            <TextBlock
                HorizontalAlignment="Center"
                Text="文件名"
                VerticalAlignment="Center"
                Width="50" />
            <ComboBox
                HorizontalAlignment="Center"
                ItemsSource="{Binding FilterOptionList}"
                SelectedItem="{Binding FilterOption}"
                VerticalAlignment="Center"
                Width="120" />
            <TextBox
                AcceptsReturn="False"
                HorizontalAlignment="Center"
                Text="{Binding FilterText}"
                VerticalAlignment="Center"
                Watermark="填入字符串(多个按空格分隔)"
                Width="240" />
        </StackPanel>

        <StackPanel
            Grid.Column="0"
            Grid.Row="4"
            Margin="5"
            Orientation="Horizontal">
            <Button
                Command="{Binding AnalyzeRisksCommand}"
                Content="开始分析"
                Height="40"
                Margin="5" />
            <TextBlock
                HorizontalAlignment="Center"
                Text="{Binding Progress}"
                VerticalAlignment="Center"
                Width="150" />
        </StackPanel>

        <DataGrid
            BorderBrush="Gray"
            BorderThickness="1"
            CanUserReorderColumns="False"
            CanUserResizeColumns="True"
            CanUserSortColumns="False"
            Grid.Column="1"
            Grid.Row="0"
            Grid.RowSpan="5"
            GridLinesVisibility="All"
            IsEnabled="{Binding !IsAnalyzing}"
            IsReadOnly="True"
            ItemsSource="{Binding RiskDetectResults}"
            Margin="20"
            Name="RiskDetectResultsGrid"
            SelectedIndex="{Binding SelectedDataGridIndex}"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Binding="{Binding FileName}"
                    Header="文件名"
                    Width="320" />
                <DataGridTextColumn
                    Binding="{Binding Shape}"
                    Header="宽高"
                    Width="100" />
                <DataGridTextColumn
                    Binding="{Binding TaskName}"
                    Header="任务"
                    Width="80" />
                <DataGridTextColumn
                    Binding="{Binding GuessedLabel}"
                    Header="猜测标签"
                    Width="120" />
                <DataGridTextColumn
                    Binding="{Binding PredictLabel}"
                    Header="预测标签"
                    Width="120" />
                <DataGridTextColumn
                    Binding="{Binding PredictScore}"
                    Header="分数"
                    Width="80" />
                <DataGridTextColumn
                    Binding="{Binding Description}"
                    Header="左上x,左上y,右上x,右上y"
                    Width="220" />
            </DataGrid.Columns>
        </DataGrid>
        <Image
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Grid.Row="5"
            Grid.RowSpan="2"
            Source="{Binding PresentImage}"
            Stretch="Fill" />
        <StackPanel
            Grid.Column="0"
            Grid.Row="7"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Command="{Binding InitializePlayTimerCommand}"
                Content="自动（V）"
                Height="40"
                Margin="0,10,10,0" />
            <Button
                Classes="Standard"
                Command="{Binding PreviousJpgCommand}"
                Content="上一张（A/W）"
                Margin="0,10,10,0"
                Width="250" />
            <Button
                Classes="Standard"
                Command="{Binding NextJpgCommand}"
                Content="下一张（S/D）"
                Margin="0,10,10,0"
                Width="250" />
            <Button
                Classes="Outlined Danger"
                Command="{Binding MarkErrorCommand}"
                CommandParameter="true"
                Content="标记异常（E）"
                Margin="0,10,0,0"
                Width="250" />
            <Button
                Classes="Outlined Success"
                Command="{Binding MarkErrorCommand}"
                CommandParameter="false"
                Content="标记误检（F）"
                Margin="10,10,0,0"
                Width="250" />
            <Button
                Classes="Outlined Information"
                Command="{Binding RevokeErrorCommand}"
                CommandParameter="false"
                Content="撤销标记（Q）"
                Margin="10,10,0,0"
                Width="200" />

            <!--  <CheckBox  -->
            <!--  Content="定时自动裁剪"  -->
            <!--  IsChecked="{Binding AutoClassifyEnabled}"  -->
            <!--  IsEnabled="{Binding !IsAnalyzing}"  -->
            <!--  Margin="5"  -->
            <!--  Width="50" />  -->
        </StackPanel>

    </Grid>
</sukiUi:SukiWindow>
