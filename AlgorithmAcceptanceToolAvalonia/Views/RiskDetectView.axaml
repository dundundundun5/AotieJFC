<sukiUi:SukiWindow
    CanResize="False"
    Height="800"
    Title="异常检测"
    Width="1500"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    x:Class="AlgoritmAcceptanceToolAvalonia.Views.RiskDetectView"
    x:DataType="vm:RiskDetectViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sukiUi="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    xmlns:vm="clr-namespace:AlgoritmAcceptanceToolAvalonia.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.DataContext>
        <vm:RiskDetectViewModel />
    </Design.DataContext>
    <sukiUi:SukiWindow.Hosts>
        <sukiUi:SukiDialogHost Manager="{Binding DialogManager}" />
    </sukiUi:SukiWindow.Hosts>
    <Window.KeyBindings>
        <KeyBinding Command="{Binding NextJpgCommand}" Gesture="Right" />
        <KeyBinding Command="{Binding NextJpgCommand}" Gesture="Down" />
        <KeyBinding Command="{Binding PreviousJpgCommand}" Gesture="Left" />
        <KeyBinding Command="{Binding PreviousJpgCommand}" Gesture="Up" />
        <KeyBinding Command="{Binding MarkErrorCommand}" Gesture="Space" />
        <KeyBinding Command="{Binding MarkErrorCommand}" Gesture="Enter" />
    </Window.KeyBindings>
    <Grid
        ColumnDefinitions="400, *"
        RenderOptions.BitmapInterpolationMode="HighQuality"
        RowDefinitions="50,50,250,300,50,*">
        <StackPanel
            Grid.Column="0"
            Grid.Row="0"
            Margin="5"
            Orientation="Horizontal">
            <TextBlock
                HorizontalAlignment="Center"
                Text="检测目录："
                VerticalAlignment="Center" />
            <TextBox
                Height="40"
                HorizontalContentAlignment="Center"
                IsReadOnly="True"
                Text="{Binding ImagePath}"
                VerticalContentAlignment="Center"
                Width="200" />
            <Button
                Click="OpenFolder"
                Content="选择目录"
                Height="40"
                IsEnabled="{Binding !IsAnalyzing}"
                Margin="5" />

        </StackPanel>
        <StackPanel
            Grid.Column="0"
            Grid.Row="1"
            Margin="5"
            Orientation="Horizontal">
            <TextBlock Text="类别：" VerticalAlignment="Center" />
            <ComboBox
                IsEnabled="{Binding !IsAnalyzing}"
                ItemsSource="{Binding TaskNameList}"
                Margin="5"
                SelectedItem="{Binding SelectedTaskName}"
                VerticalAlignment="Center" />
            <Button
                Command="{Binding AnalyzeRisksCommand}"
                Content="开始分析"
                Height="40"
                Margin="5" />
        </StackPanel>

        <DataGrid
            BorderBrush="Gray"
            BorderThickness="1"
            CanUserReorderColumns="False"
            CanUserResizeColumns="False"
            CanUserSortColumns="False"
            Grid.Column="1"
            Grid.Row="0"
            Grid.RowSpan="3"
            GridLinesVisibility="None"
            IsEnabled="{Binding !IsAnalyzing}"
            IsReadOnly="True"
            ItemsSource="{Binding RiskDetectResults}"
            Margin="20"
            Name="RiskDetectResultsGrid"
            SelectedIndex="{Binding SelectedDataGridIndex}"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Binding="{Binding Timestamp}"
                    Header="时间"
                    Width="160" />

                <DataGridTextColumn
                    Binding="{Binding FileName}"
                    Header="文件名"
                    Width="280" />

                <DataGridTextColumn
                    Binding="{Binding TrueLabel}"
                    Header="真实标签"
                    Width="150" />
                <DataGridTextColumn
                    Binding="{Binding PredictLabel}"
                    Header="预测标签"
                    Width="150" />
                <DataGridTextColumn
                    Binding="{Binding PredictScore}"
                    Header="预测分数"
                    Width="150" />
            </DataGrid.Columns>
        </DataGrid>
        <Image
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Grid.Row="3"
            Source="{Binding PresentImage}"
            Stretch="Fill" />
        <StackPanel
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Grid.Row="4"
            HorizontalAlignment="Center"
            Orientation="Horizontal">

            <Button
                Classes="Rounded"
                Command="{Binding PreviousJpgCommand}"
                Content="上一张"
                Margin="0,10,10,0"
                Width="400" />
            <Button
                Classes="Rounded"
                Command="{Binding NextJpgCommand}"
                Content="下一张"
                Margin="0,10,10,0"
                Width="400" />
            <Button
                Classes="Outlined"
                Command="{Binding MarkErrorCommand}"
                Content="标记错误"
                Margin="0,10,0,0"
                Width="300" />
        </StackPanel>

    </Grid>
</sukiUi:SukiWindow>
