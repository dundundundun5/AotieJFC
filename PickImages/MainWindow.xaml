<Window
    FontFamily="Consolas"
    FontSize="14"
    Height="450"
    Margin="0"
    Title="根据长图找原图v1.0.0"
    Width="820"
    mc:Ignorable="d"
    x:Class="PickImagesTool.MainWindow"
    x:Name="dundun"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="600" />
            <ColumnDefinition Width="200" />

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="220" />
        </Grid.RowDefinitions>


        <TextBox
            AcceptsReturn="True"
            AcceptsTab="True"
            Background="White"
            FontFamily="Consolas"
            FontSize="13"
            Foreground="Black"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Grid.Row="4"
            Height="190"
            HorizontalScrollBarVisibility="Auto"
            IsReadOnly="True"
            Margin="5"
            TextWrapping="NoWrap"
            VerticalScrollBarVisibility="Auto"
            Width="750"
            x:Name="myConsole" />

        <StackPanel
            DataContext="{Binding ElementName=dundun}"
            Grid.Row="3"
            Orientation="Horizontal">
            <ComboBox
                Height="25"
                IsEnabled="False"
                IsReadOnly="True"
                ItemStringFormat="yyyy-MM-dd"
                ItemsSource="{Binding DateList}"
                Margin="5"
                SelectedIndex="1"
                SelectionChanged="DatetimeChanged"
                Width="110"
                x:Name="DatetimeComboBox" />
            <Button
                Click="GatherWarningClick"
                Content="汇总历史告警并上传"
                Height="40"
                HorizontalAlignment="Left"
                IsEnabled="True"
                Margin="5"
                Width="220"
                x:Name="GatherWarningButton" />

        </StackPanel>


    </Grid>
</Window>
