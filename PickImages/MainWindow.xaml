<Window
    FontFamily="Consolas"
    FontSize="14"
    Height="450"
    Margin="0"
    Title="根据长图找原图v1.0.0"
    Width="820"
    mc:Ignorable="d"
    x:Class="PickImages.MainWindow"
    x:Name="dundun"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PickImages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="600" />
            <ColumnDefinition Width="200" />

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="220" />
        </Grid.RowDefinitions>

        <!--  显示选择的文件路径  -->



        <!--  浏览文件按钮  -->
        <Button
            Click="OCRButton1_Click"
            Content="选择文件并找原图"
            Grid.Column="1"
            Height="40"
            HorizontalAlignment="Left"
            Margin="5"
            Width="190"
            x:Name="OCRButton1" />

        <Button
            Click="DetectCSButton_Click"
            Content="选择文件夹并找原图"
            Grid.Column="1"
            Grid.Row="1"
            Height="40"
            HorizontalAlignment="Left"
            Margin="5"
            Width="190"
            x:Name="DetectCSButton" />
        <Button
            Click="DetectZXButton_Click"
            Content="选择文件夹并找原图"
            Grid.Column="1"
            Grid.Row="2"
            Height="40"
            HorizontalAlignment="Left"
            Margin="5"
            Width="190"
            x:Name="DetectZXButton" />
        <TextBox
            Height="20"
            IsReadOnly="True"
            Margin="10"
            Text="======选择站点名_日期XXX.csv====="
            Width="Auto"
            x:Name="OCRFile1" />

        <TextBox
            Grid.Row="1"
            Height="20"
            IsReadOnly="True"
            Margin="10"
            Text="======选择车身误检测文件夹====="
            Width="Auto"
            x:Name="DetectCSFolder" />
        <TextBox
            Grid.Row="2"
            Height="20"
            IsReadOnly="True"
            Margin="10"
            Text="======选择走行误检测文件夹======"
            Width="Auto"
            x:Name="DetectZXFolder" />
        <TextBox
            AcceptsReturn="True"
            AcceptsTab="True"
            Background="White"
            FontFamily="Consolas"
            FontSize="13"
            Foreground="Black"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Grid.Row="4"
            Height="190"
            HorizontalScrollBarVisibility="Auto"
            IsReadOnly="True"
            Margin="5"
            TextWrapping="NoWrap"
            VerticalScrollBarVisibility="Auto"
            Width="750"
            x:Name="myConsole" />

        <StackPanel
            DataContext="{Binding ElementName=dundun}"
            Grid.Row="3"
            Orientation="Horizontal">
            <ComboBox
                Height="25"
                ItemStringFormat="yyyy-MM-dd"
                ItemsSource="{Binding DateList}"
                Margin="5"
                SelectedIndex="1"
                SelectionChanged="DatetimeChanged"
                Width="110"
                x:Name="DatetimeComboBox" />
            <Button
                Click="GatherWarningClick"
                Content="汇总Warning原图并上传"
                Height="40"
                HorizontalAlignment="Left"
                Margin="5"
                Width="200"
                x:Name="GatherWarningButton" />
            <Button
                Click="PickWarningButton_OnClick"
                Content="汇总二级分数过滤原图并上传"
                Height="40"
                HorizontalAlignment="Left"
                IsEnabled="True"
                Margin="5"
                Visibility="Hidden"
                Width="250"
                x:Name="PickWarningButton" />
        </StackPanel>
        <Button
            Click="FtpClick"
            Content="误检测FTP"
            Grid.Column="1"
            Grid.Row="3"
            Height="40"
            HorizontalAlignment="Left"
            Margin="5"
            Visibility="Hidden"
            Width="190"
            x:Name="FtpButton" />


    </Grid>
</Window>
